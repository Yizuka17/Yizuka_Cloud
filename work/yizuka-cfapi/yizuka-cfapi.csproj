  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <PackageReference Include="Vanara.PInvoke.CldApi" Version="5.0.7" />
  </ItemGroup>

</Project>
